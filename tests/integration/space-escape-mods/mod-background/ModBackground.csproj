<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ModBackground</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\sources\engine\Modulus.Modding.Api\Modulus.Modding.Api.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\..\sources\engine\Stride.Engine\Stride.Engine.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\contracts\SpaceEscape.Contracts.csproj" PrivateAssets="all" />
  </ItemGroup>
  <!-- Prevent Stride DLLs from being copied to mod output — they come from the engine's ALC -->
  <Target Name="RemoveStrideDlls" AfterTargets="Build">
    <ItemGroup>
      <!-- Remove all Stride.*.dll except Stride.dll itself (native interop) -->
      <StrideDlls Include="$(OutputPath)Stride.*.dll" Exclude="$(OutputPath)Stride.dll" />
      <StridePdbs Include="$(OutputPath)Stride.*.pdb" />
    </ItemGroup>
    <Delete Files="@(StrideDlls)" />
    <Delete Files="@(StridePdbs)" />
  </Target>
</Project>
