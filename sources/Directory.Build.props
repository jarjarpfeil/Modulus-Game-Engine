<Project>
  <PropertyGroup>
    <!-- StrideRoot points to the repository root (one level above sources/).
         This file is auto-discovered during Microsoft.Common.props evaluation, which
         happens inside Microsoft.NET.Sdk initialization — i.e., inside Sdk.props.
         Therefore $(StrideRoot) is available within SDK files and for the closing
         targets <Import> at the bottom of project files, but NOT for the opening
         props <Import> (which uses GetDirectoryNameOfFileAbove to locate Sdk.props
         without any pre-set property). See docs/build/SDK-GUIDE.md for details. -->
    <StrideRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</StrideRoot>
  </PropertyGroup>
  <!-- Workaround: Roslyn language server (v2.140.x) ships a BuildHost with a version of
       Microsoft.NET.HostModel that is incompatible with .NET 10 SDK's System.Reflection.PortableExecutable.
       This causes CreateAppHost to throw MissingMethodException on PEHeaders.get_SectionHeaders()
       during design-time builds. Disabling UseAppHost for design-time builds fixes the LS errors
       without affecting actual builds (dotnet run/test still work fine). -->
  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>