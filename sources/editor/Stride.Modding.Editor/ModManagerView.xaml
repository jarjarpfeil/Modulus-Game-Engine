<UserControl x:Class="Stride.Modding.Editor.ModManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Stride.Modding.Editor"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:ModManagerViewModel}">

  <DockPanel>
    <!-- Toolbar -->
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Command="{Binding InstallModCommand}" ToolTip="Install .modpkg file">
          <TextBlock Text="📦+" FontSize="14"/>
        </Button>
        <Button Command="{Binding UninstallModCommand}" ToolTip="Uninstall selected mod">
          <TextBlock Text="🗑" FontSize="14"/>
        </Button>
        <Separator/>
        <Button Command="{Binding EnableModCommand}" ToolTip="Enable selected mod">
          <TextBlock Text="✓" FontSize="14" Foreground="Green"/>
        </Button>
        <Button Command="{Binding DisableModCommand}" ToolTip="Disable selected mod">
          <TextBlock Text="✗" FontSize="14" Foreground="Red"/>
        </Button>
        <Separator/>
        <Button Command="{Binding ReloadModCommand}" ToolTip="Reload selected mod (applies on next game start)">
          <TextBlock Text="↻" FontSize="14" Foreground="Blue"/>
        </Button>
        <Separator/>
        <Button Command="{Binding RefreshCommand}" ToolTip="Refresh mod list">
          <TextBlock Text="⟳" FontSize="14"/>
        </Button>
      </ToolBar>
    </ToolBarTray>

    <!-- Status bar at bottom -->
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
    </StatusBar>

    <!-- Main content -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="1*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="1*"/>
      </Grid.RowDefinitions>

      <!-- Mod list -->
      <ListView Grid.Row="0" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
        <ListView.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ModInfoViewModel}">
            <Grid Margin="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Enable/disable checkbox -->
              <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="4,0"/>

              <!-- Mod info -->
              <StackPanel Grid.Column="1" Margin="4,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Version}" Foreground="Gray" FontSize="11"/>
                  <TextBlock Text=" | " Foreground="Gray" FontSize="11"/>
                  <TextBlock Text="{Binding Id}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>

              <!-- State indicator -->
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="4,0" FontSize="11">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Enabled"/>
                    <Setter Property="Foreground" Value="Green"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter Property="Text" Value="Disabled"/>
                        <Setter Property="Foreground" Value="Gray"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- Splitter: mod list / details -->
      <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

      <!-- Details panel -->
      <Border Grid.Row="2" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ContentControl Content="{Binding SelectedMod}">
            <ContentControl.ContentTemplate>
              <DataTemplate DataType="{x:Type vm:ModInfoViewModel}">
                <StackPanel>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Author:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Author, FallbackValue=N/A}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="API Version:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApiVersion}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Dependencies:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DependenciesText}" TextWrapping="Wrap"/>
                  </Grid>

                  <TextBlock Text="Description:" FontWeight="SemiBold" Margin="0,8,0,2"/>
                  <TextBlock Text="{Binding Description, FallbackValue=No description}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>

      <!-- Splitter: details / console -->
      <GridSplitter Grid.Row="3" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

      <!-- Mod Console -->
      <Border Grid.Row="4" Padding="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Mod Console" FontWeight="SemiBold" Padding="4,2"
                     Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
          <ListView ItemsSource="{Binding ModConsoleMessages}" BorderThickness="0"
                    VirtualizingPanel.IsVirtualizing="True"
                    FontFamily="Consolas" FontSize="11">
            <ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="NoWrap" Padding="4,1"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
