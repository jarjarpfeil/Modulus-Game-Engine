<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>ModulusEngine.Templates</PackageId>
    <Title>Modulus Engine Templates</Title>
    <Description>Templates for creating Modulus Engine games and mods.</Description>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Modulus Engine Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Modulus-Engine/modulus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Modulus-Engine/modulus</RepositoryUrl>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="modulus-game/**/*" Exclude="modulus-game/**/bin/**;modulus-game/**/obj/**" />
    <Content Include="modulus-mod/**/*" Exclude="modulus-mod/**/bin/**;modulus-mod/**/obj/**" />
    <Compile Remove="**/*" />
  </ItemGroup>

</Project>
